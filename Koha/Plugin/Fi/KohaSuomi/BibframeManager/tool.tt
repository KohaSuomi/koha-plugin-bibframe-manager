<!DOCTYPE html>
<html>
<head>
    <title>Bibframe Manager - Create Bibframe Record</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    </script>
    
    <style>
        .entity-card {
            border: 2px solid #dee2e6;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            background-color: #fff;
            transition: all 0.3s;
        }
        .entity-card:hover {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .entity-card.work {
            border-left: 5px solid #007bff;
        }
        .entity-card.expression {
            border-left: 5px solid #28a745;
        }
        .entity-card.manifestation {
            border-left: 5px solid #ffc107;
        }
        .entity-card.item {
            border-left: 5px solid #dc3545;
        }
        .entity-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        .property-row {
            background-color: #f8f9fa;
            border-radius: 5px;
            padding: 10px;
            margin-bottom: 10px;
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .property-row .form-control {
            flex: 1;
        }
        .badge-entity {
            font-size: 14px;
            padding: 5px 10px;
        }
        .result-box {
            background-color: #f5f5f5;
            border: 1px solid #ccc;
            border-radius: 5px;
            padding: 15px;
            max-height: 500px;
            overflow-y: auto;
            font-family: monospace;
            font-size: 12px;
            white-space: pre-wrap;
        }
        .nav-tabs .nav-link.active {
            background-color: #005580;
            color: white;
        }
        .entity-type-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .entity-type-btn {
            flex: 1;
            min-width: 200px;
            padding: 15px;
            text-align: center;
            border: 2px dashed #ccc;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            background-color: white;
        }
        .entity-type-btn:hover {
            border-color: #007bff;
            background-color: #f8f9fa;
        }
        .sidebar {
            background-color: #f8f9fa;
            border-right: 1px solid #dee2e6;
            padding: 20px;
            max-height: calc(100vh - 200px);
            overflow-y: auto;
        }
        .property-suggestion {
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 4px;
            margin: 2px;
            display: inline-block;
            background-color: #e9ecef;
            font-size: 12px;
        }
        .property-suggestion:hover {
            background-color: #007bff;
            color: white;
        }
        .level-info {
            background-color: #e7f3ff;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="main-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/cgi-bin/koha/mainpage.pl">Home</a></li>
            <li class="breadcrumb-item"><a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a></li>
            <li class="breadcrumb-item active" aria-current="page">Bibframe Manager</li>
        </ol>
    </nav>
    <!-- /Breadcrumb -->

    <div id="bibframe-app" class="container-fluid mt-4">
        <div class="row">
            <div class="col-12">
                <h2><i class="fas fa-project-diagram"></i> Bibframe Record Builder</h2>
                <p class="text-muted">Create Finnish BFFI(Bibframe) records from scratch using the four-level RDA structure</p>
                <hr>
            </div>
        </div>

        <!-- Alerts -->
        <div class="row" v-if="error">
            <div class="col-12">
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong><i class="fas fa-exclamation-triangle"></i> Error!</strong> {{ error }}
                    <button type="button" class="btn-close" @click="error = null" aria-label="Close"></button>
                </div>
            </div>
        </div>

        <div class="row" v-if="success">
            <div class="col-12">
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong><i class="fas fa-check-circle"></i> Success!</strong> {{ success }}
                    <button type="button" class="btn-close" @click="success = null" aria-label="Close"></button>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Left Sidebar - Property Suggestions -->
            <div class="col-md-3">
                <div class="sidebar">
                    <h5><i class="fas fa-lightbulb"></i> Property Suggestions</h5>
                    <hr>
                    
                    <!-- Work Properties -->
                    <div class="mb-3">
                        <h6 class="text-primary"><i class="fas fa-book"></i> Work Properties</h6>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:creator')">creator</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:preferredTitle')">preferredTitle</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:formOfWork')">formOfWork</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:subject')">subject</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:genreForm')">genreForm</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:intendedAudience')">intendedAudience</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('work', 'Bibframe:medium')">medium</div>
                    </div>

                    <!-- Expression Properties -->
                    <div class="mb-3">
                        <h6 class="text-success"><i class="fas fa-file-alt"></i> Expression Properties</h6>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:title')">title</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:language')">language</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:edition')">edition</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:contentType')">contentType</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:contributor')">contributor</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:note')">note</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('expression', 'Bibframe:tableOfContents')">tableOfContents</div>
                    </div>

                    <!-- Manifestation Properties -->
                    <div class="mb-3">
                        <h6 class="text-warning"><i class="fas fa-box"></i> Manifestation Properties</h6>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:isbn')">isbn</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:issn')">issn</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:publication')">publication</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:extent')">extent</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:mediaType')">mediaType</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:carrierType')">carrierType</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('manifestation', 'Bibframe:electronicLocation')">electronicLocation</div>
                    </div>

                    <!-- Item Properties -->
                    <div class="mb-3">
                        <h6 class="text-danger"><i class="fas fa-barcode"></i> Item Properties</h6>
                        <div class="property-suggestion" @click="addPropertySuggestion('item', 'Bibframe:heldBy')">heldBy</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('item', 'Bibframe:itemInformation')">itemInformation</div>
                        <div class="property-suggestion" @click="addPropertySuggestion('item', 'Bibframe:enumerationAndChronology')">enumerationAndChronology</div>
                    </div>

                    <!-- Namespaces Info -->
                    <div class="mt-4">
                        <h6><i class="fas fa-info-circle"></i> Namespaces</h6>
                        <small class="text-muted">
                            <div><strong>bffi:</strong> Finnish BIBFRAME</div>
                            <div><strong>bf:</strong> BIBFRAME</div>
                            <div><strong>rdaw/e/m/i:</strong> RDA Elements</div>
                        </small>
                    </div>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-md-9">
                <!-- Record Metadata -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-cog"></i> Record Metadata</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="baseUri">Base URI:</label>
                                    <input type="text" class="form-control" id="baseUri" v-model="baseUri" placeholder="http://urn.fi/URN:NBN:fi:bib:">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="recordId">Record ID:</label>
                                    <input type="text" class="form-control" id="recordId" v-model="recordId" placeholder="unique-id">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Add Entity Buttons -->
                <div class="entity-type-selector">
                    <div class="entity-type-btn" @click="addEntity('work')">
                        <i class="fas fa-book fa-2x text-primary"></i>
                        <h6 class="mt-2">Add Work</h6>
                        <small class="text-muted">Abstract creation</small>
                    </div>
                    <div class="entity-type-btn" @click="addEntity('expression')">
                        <i class="fas fa-file-alt fa-2x text-success"></i>
                        <h6 class="mt-2">Add Expression</h6>
                        <small class="text-muted">Specific realization</small>
                    </div>
                    <div class="entity-type-btn" @click="addEntity('manifestation')">
                        <i class="fas fa-box fa-2x text-warning"></i>
                        <h6 class="mt-2">Add Manifestation</h6>
                        <small class="text-muted">Physical embodiment</small>
                    </div>
                    <div class="entity-type-btn" @click="addEntity('item')">
                        <i class="fas fa-barcode fa-2x text-danger"></i>
                        <h6 class="mt-2">Add Item</h6>
                        <small class="text-muted">Single example</small>
                    </div>
                </div>

                <!-- Entities List -->
                <div v-if="entities.length === 0" class="text-center text-muted p-5">
                    <i class="fas fa-plus-circle fa-4x mb-3"></i>
                    <p>Click above to add your first entity</p>
                </div>

                <div v-for="(entity, entityIndex) in entities" :key="entityIndex">
                    <div class="entity-card" :class="entity.type">
                        <div class="entity-header">
                            <div>
                                <h5>
                                    <span class="badge badge-entity" :class="'badge-' + getEntityBadgeClass(entity.type)">
                                        <i :class="getEntityIcon(entity.type)"></i>
                                        {{ entity.type.charAt(0).toUpperCase() + entity.type.slice(1) }}
                                    </span>
                                </h5>
                                <div class="level-info">
                                    <small>{{ getEntityDescription(entity.type) }}</small>
                                </div>
                            </div>
                            <button class="btn btn-danger btn-sm" @click="removeEntity(entityIndex)">
                                <i class="fas fa-trash"></i> Remove
                            </button>
                        </div>

                        <!-- Entity URI -->
                        <div class="form-group">
                            <label>Entity URI:</label>
                            <input type="text" class="form-control" v-model="entity.uri" :placeholder="baseUri + recordId + '/' + entity.type">
                        </div>

                        <!-- Properties -->
                        <div class="form-group">
                            <label><i class="fas fa-tags"></i> Properties:</label>
                            <div v-for="(prop, propIndex) in entity.properties" :key="propIndex" class="property-row">
                                <select class="form-control" v-model="prop.predicate" @change="updatePropertyType(entityIndex, propIndex)">
                                    <option value="">Select property...</option>
                                    <optgroup :label="entity.type.charAt(0).toUpperCase() + entity.type.slice(0) + ' Properties'">
                                        <option v-for="suggestion in getPropertySuggestions(entity.type)" :value="suggestion.value">
                                            {{ suggestion.label }}
                                        </option>
                                    </optgroup>
                                    <optgroup label="Custom">
                                        <option value="custom">Custom property...</option>
                                    </optgroup>
                                </select>
                                
                                <input v-if="prop.predicate === 'custom'" type="text" class="form-control" v-model="prop.customPredicate" placeholder="Custom predicate URI">
                                
                                <select class="form-control" v-model="prop.objectType" style="max-width: 150px;">
                                    <option value="literal">Literal</option>
                                    <option value="uri">URI</option>
                                </select>
                                
                                <input type="text" class="form-control" v-model="prop.object" :placeholder="prop.objectType === 'uri' ? 'URI' : 'Value'">
                                
                                <button class="btn btn-sm btn-danger" @click="removeProperty(entityIndex, propIndex)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <button class="btn btn-sm btn-secondary mt-2" @click="addProperty(entityIndex)">
                                <i class="fas fa-plus"></i> Add Property
                            </button>
                        </div>

                        <!-- Relationships -->
                        <div class="form-group">
                            <label><i class="fas fa-link"></i> Relationships:</label>
                            <div v-for="(rel, relIndex) in entity.relationships" :key="relIndex" class="property-row">
                                <select class="form-control" v-model="rel.predicate">
                                    <option value="">Select relationship...</option>
                                    <option value="bffi:expressionOf">expressionOf (Expression → Work)</option>
                                    <option value="bffi:manifestationOf">manifestationOf (Manifestation → Expression)</option>
                                    <option value="bffi:itemOf">itemOf (Item → Manifestation)</option>
                                    <option value="bffi:hasExpression">hasExpression (Work → Expression)</option>
                                    <option value="bffi:hasManifestation">hasManifestation (Expression → Manifestation)</option>
                                    <option value="bffi:hasItem">hasItem (Manifestation → Item)</option>
                                    <option value="custom">Custom relationship...</option>
                                </select>
                                
                                <input v-if="rel.predicate === 'custom'" type="text" class="form-control" v-model="rel.customPredicate" placeholder="Custom relationship URI">
                                
                                <input type="text" class="form-control" v-model="rel.targetUri" placeholder="Target entity URI">
                                
                                <button class="btn btn-sm btn-danger" @click="removeRelationship(entityIndex, relIndex)">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <button class="btn btn-sm btn-secondary mt-2" @click="addRelationship(entityIndex)">
                                <i class="fas fa-plus"></i> Add Relationship
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="card" v-if="entities.length > 0">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-save"></i> Save & Export</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="outputFormat">Output Format:</label>
                                    <select class="form-control" id="outputFormat" v-model="outputFormat">
                                        <option value="turtle">Turtle (TTL)</option>
                                        <option value="json-ld">JSON-LD</option>
                                        <option value="ntriples">N-Triples</option>
                                        <option value="rdf-xml">RDF/XML</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-primary btn-lg" @click="generateBibframe">
                                <i class="fas fa-magic"></i> Generate Bibframe Record
                            </button>
                            <button class="btn btn-secondary btn-lg ml-2" @click="resetForm">
                                <i class="fas fa-redo"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Preview/Output -->
                <div class="card mt-3" v-if="generatedOutput">
                    <div class="card-header" style="background-color: #005580; color: white;">
                        <h5><i class="fas fa-eye"></i> Generated Bibframe Record</h5>
                    </div>
                    <div class="card-body">
                        <ul class="nav nav-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" data-toggle="tab" href="#preview" role="tab">
                                    <i class="fas fa-align-left"></i> Preview
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" data-toggle="tab" href="#triples" role="tab">
                                    <i class="fas fa-list"></i> Triples
                                </a>
                            </li>
                        </ul>

                        <div class="tab-content mt-3">
                            <div class="tab-pane fade show active" id="preview" role="tabpanel">
                                <div class="result-box">{{ generatedOutput }}</div>
                                <button class="btn btn-secondary btn-sm mt-2" @click="downloadOutput">
                                    <i class="fas fa-download"></i> Download
                                </button>
                                <button class="btn btn-secondary btn-sm mt-2 ml-2" @click="copyToClipboard">
                                    <i class="fas fa-copy"></i> Copy to Clipboard
                                </button>
                                <button class="btn btn-secondary btn-sm mt-2 ml-2" @click="saveToDatabase">
                                    <i class="fas fa-database"></i> Save to Database
                                </button>
                            </div>
                            <div class="tab-pane fade" id="triples" role="tabpanel">
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Subject</th>
                                                <th>Predicate</th>
                                                <th>Object</th>
                                                <th>Type</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="triple in allTriples" :key="triple.id">
                                                <td><small>{{ triple.subject }}</small></td>
                                                <td><small>{{ triple.predicate }}</small></td>
                                                <td><small>{{ triple.object }}</small></td>
                                                <td><small>{{ triple.objectType }}</small></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Documentation -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header" style="background-color: #005580; color: white;">
                    <h5><i class="fas fa-book"></i> Bibframe Four-Level Structure</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <h6 class="text-primary"><i class="fas fa-book"></i> Work</h6>
                            <p><small>Abstract intellectual or artistic creation. The conceptual essence of the resource.</small></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-success"><i class="fas fa-file-alt"></i> Expression</h6>
                            <p><small>Specific realization of a work (e.g., a particular edition, translation, or version).</small></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-warning"><i class="fas fa-box"></i> Manifestation</h6>
                            <p><small>Physical embodiment of an expression (equivalent to BIBFRAME Instance).</small></p>
                        </div>
                        <div class="col-md-3">
                            <h6 class="text-danger"><i class="fas fa-barcode"></i> Item</h6>
                            <p><small>Single example of a manifestation. The actual physical or digital copy.</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vue/3.4.15/vue.global.min.js" integrity="sha512-YX1AhLUs26nJDkqXrSgg6kjMat++etdfsgcphWSPcglBGp/sk5I0/pKuu/XIfOCuzDU4GHcOB1E9LlveutWiBw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vue-demi/0.14.6/index.iife.min.js" integrity="sha512-4bZPx/4GmRQW9DcQEbYpO4nLPaIceJ/gfouiSkpLCrrYYKFC9W+dk5dCT5WaDkRoWIMyG+Zw853iFABZgatpYw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pinia/2.1.7/pinia.iife.min.js" integrity="sha512-o2oH6iY7StQR/0l/6CJpuET6bT1RyGQWUpu1nWLIcGuFZnV4iOlSvtgUrO+i4x3QtoZSve8SAb1LplJWEZTj0w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    
    <!-- Vue.js 3 Application -->
    <script type="module" src="[%PLUGIN_PATH%]/js/app.js"></script>
</body>
</html>