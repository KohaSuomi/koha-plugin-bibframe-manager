{
  "/bibframe/convert": {
    "post": {
      "x-mojo-to": "Fi::KohaSuomi::BibframeManager::Controllers::BibframeController#convert",
      "operationId": "convertToBibframe",
      "x-koha-authorization": {
        "permissions": {
          "plugins": "tool"
        }
      },
      "tags": ["bibframe"],
      "summary": "Convert MARC21 to Bibframe",
      "description": "Converts a MARC21 record to Bibframe format",
      "consumes": [
        "multipart/form-data",
        "application/x-www-form-urlencoded"
      ],
      "produces": [
        "application/json"
      ],
      "parameters": [
          {
            "name": "method",
            "in": "formData",
            "description": "Input method: biblio, marc, or text",
            "required": true,
            "type": "string",
            "enum": ["biblio", "marc", "text"]
          },
          {
            "name": "biblionumber",
            "in": "formData",
            "description": "Biblionumber (required if method=biblio)",
            "required": false,
            "type": "integer"
          },
          {
            "name": "marc_file",
            "in": "formData",
            "description": "MARC file upload (required if method=marc)",
            "required": false,
            "type": "file"
          },
          {
            "name": "marc_text",
            "in": "formData",
            "description": "MARC text (required if method=text)",
            "required": false,
            "type": "string"
          },
          {
            "name": "base_uri",
            "in": "formData",
            "description": "Base URI for RDF resources",
            "required": false,
            "type": "string",
            "default": "http://urn.fi/URN:NBN:fi:bib:"
          },
          {
            "name": "format",
            "in": "formData",
            "description": "Output format",
            "required": false,
            "type": "string",
            "enum": ["turtle", "json-ld", "ntriples", "rdf-xml"],
            "default": "turtle"
          },
          {
            "name": "save_to_db",
            "in": "formData",
            "description": "Save to database (biblio_metadata table)",
            "required": false,
            "type": "integer",
            "enum": [0, 1],
            "default": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Successful conversion",
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "description": "Conversion success status"
                },
                "triples": {
                  "type": "array",
                  "description": "Array of RDF triples",
                  "items": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "predicate": {
                        "type": "string"
                      },
                      "object": {
                        "type": "string"
                      },
                      "object_type": {
                        "type": "string"
                      }
                    }
                  }
                },
                "formatted": {
                  "type": "string",
                  "description": "Formatted output in requested format"
                },
                "format": {
                  "type": "string",
                  "description": "Output format used"
                },
                "triple_count": {
                  "type": "integer",
                  "description": "Number of triples generated"
                },
                "biblionumber": {
                  "type": "integer",
                  "description": "Biblionumber of the converted record"
                },
                "metadata_id": {
                  "type": "integer",
                  "description": "Metadata ID if saved to database"
                },
                "message": {
                  "type": "string",
                  "description": "Success message"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "Error message"
                }
              }
            }
          },
          "404": {
            "description": "Record not found",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "Error message"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "Error message"
                }
              }
            }
          }
        }
      }
    }
  }
}
